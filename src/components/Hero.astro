---
import Button from './Button.astro';
import { ArrowRight } from 'lucide-react';
---

<section class="relative h-screen min-h-[600px] flex items-center justify-center overflow-hidden">
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-0">
    <img 
      src="/images/hero-bg.jpg" 
      alt="Un Grano de Arena" 
      class="w-full h-full object-cover hero-zoom"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-brown-900/80 via-brown-800/70 to-brown-900/90"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 container-custom text-center text-white">
    <h1 class="font-heading font-bold text-5xl md:text-6xl lg:text-7xl mb-6 fade-in text-primary-300">
      Un Grano de Arena
    </h1>
    <p class="text-2xl md:text-3xl lg:text-4xl mb-4 max-w-4xl mx-auto fade-in font-bold text-white" style="animation-delay: 0.2s;">
      Nadie florece solo
    </p>
    <p class="text-xl md:text-2xl lg:text-3xl mb-8 max-w-3xl mx-auto fade-in text-gray-100" style="animation-delay: 0.3s;">
      Pongamos juntos un grano de arena
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center fade-in" style="animation-delay: 0.5s;">
      <a 
        href="#programas"
        class="inline-flex items-center justify-center px-8 py-4 text-lg font-medium rounded-lg transition-all duration-300 bg-primary-500 text-brown-800 hover:bg-primary-600 hover:shadow-lg active:scale-95"
      >
        Conoce Nuestros Programas
      </a>
      <a 
        href="https://www.paypal.com/paypalme/ungrano"
        target="_blank"
        rel="noopener noreferrer"
        class="bg-red-500 hover:bg-red-600 text-white px-8 py-4 rounded-lg font-medium transition-all duration-300 inline-flex items-center justify-center gap-2 hover:shadow-lg active:scale-95 text-lg"
      >
        Haz una Donación
      </a>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 animate-bounce">
    <div class="w-6 h-10 border-2 border-primary-300 rounded-full flex justify-center">
      <div class="w-1 h-3 bg-primary-300 rounded-full mt-2"></div>
    </div>
  </div>
</section>


