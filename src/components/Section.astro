---
interface Props {
  class?: string;
  container?: boolean;
  id?: string;
}

const { class: className = '', container = true, id } = Astro.props;
---

<section id={id} class={`section ${className}`}>
  {container ? (
    <div class="container-custom">
      <slot />
    </div>
  ) : (
    <slot />
  )}
</section>


