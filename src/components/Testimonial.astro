---
import Section from './Section.astro';
import { Quote } from 'lucide-react';
---

<Section class="bg-gradient-to-br from-accent-500 via-accent-600 to-brown-600 text-white">
  <div class="max-w-4xl mx-auto text-center">
    <Quote class="w-16 h-16 mx-auto mb-8 opacity-70 text-primary-200" />
    
    <blockquote class="text-2xl md:text-3xl font-heading font-medium mb-8 leading-relaxed">
      "Los jóvenes tenemos mucho que aportar, este es el momento de hacerlo"
    </blockquote>

    <div class="flex items-center justify-center gap-4">
      <div class="w-20 h-20 rounded-full overflow-hidden border-4 border-primary-300 shadow-lg">
        <img 
          src="/images/team/monserrat.jpg" 
          alt="Montserrat Del Valle"
          class="w-full h-full object-cover"
        />
      </div>
      <div class="text-left">
        <p class="font-bold text-xl text-white">Montserrat Del Valle</p>
        <p class="text-primary-200">Coordinadora Juvenil</p>
      </div>
    </div>
  </div>
</Section>

