---
import Navigation from './Navigation';
---

<header class="sticky top-0 z-50 bg-primary-500 shadow-lg">
  <div class="container-custom">
    <div class="flex items-center justify-between h-20 md:h-24">
      <!-- Logo -->
      <a href="/" class="flex items-center group py-2">
        <img 
          src="/images/logo-ugda.png" 
          alt="Un Grano de Arena" 
          class="h-16 md:h-20 w-auto transition-transform group-hover:scale-105"
        />
      </a>

      <!-- Navigation -->
      <Navigation client:load />
    </div>
  </div>
</header>


