---
import Section from './Section.astro';
import type { Language } from '../i18n';
import { getTranslations } from '../i18n';

interface Props {
  lang?: Language;
}

const { lang = 'es' } = Astro.props;
const t = getTranslations(lang);

const iconEmoji: Record<string, string> = {
  book: '📚',
  smile: '😁',
  party: '🎉',
  utensils: '🍽️',
  home: '🏠',
  calendar: '📅',
};
---

<Section class="bg-primary-50">
  <div class="text-center mb-12">
    <h2 class="text-brown-700 mb-4">
      {lang === 'es' ? 'Donde Sembramos Hoy, Florece el Mañana' : 'Where We Sow Today, Tomorrow Flourishes'}
    </h2>
    <p class="text-xl text-brown-600 max-w-3xl mx-auto mb-4">
      {lang === 'es' 
        ? 'En Colombia y Estados Unidos, acompañamos procesos de transformación a través de programas que siembran dignidad, esperanza y oportunidades'
        : 'In Colombia and the United States, we accompany transformation processes through programs that sow dignity, hope, and opportunities'}
    </p>
    <div class="w-20 h-1 bg-accent-500 mx-auto rounded-full"></div>
  </div>

  <div class="flex flex-wrap justify-center gap-6">
    {t.programas.map((programa) => (
      <div class="bg-white rounded-lg shadow-md hover:shadow-xl transition-shadow p-6 border-2 border-primary-200 hover:border-primary-400 w-full md:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)]">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-12 h-12 bg-primary-100 rounded-full flex items-center justify-center text-2xl flex-shrink-0">
            {programa.icon && iconEmoji[programa.icon]}
          </div>
          <h3 class="text-xl font-heading font-bold text-brown-700">{programa.title}</h3>
        </div>
        <p class="text-sm text-accent-600 font-semibold mb-3">{programa.subtitle}</p>
        <p class="text-brown-600 text-sm leading-relaxed">{programa.description}</p>
      </div>
    ))}
  </div>
</Section>
