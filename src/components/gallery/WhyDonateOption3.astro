---
import type { Language } from '../../i18n';
import { getTranslations } from '../../i18n';

interface Props {
  lang?: Language;
}

const { lang = 'es' } = Astro.props;
const t = getTranslations(lang);
---

<section class="py-20 md:py-28 bg-white">
  <div class="container-custom px-4">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="font-heading font-bold text-3xl md:text-4xl lg:text-5xl text-brown-500 mb-4">
        {t.whyDonate.title}
      </h2>
      <p class="text-xl md:text-2xl text-primary-500 font-heading font-medium mb-12">
        {t.whyDonate.subtitle}
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
        <div class="bg-primary-50 rounded-2xl p-8 text-center">
          <div class="text-4xl mb-4">🍲</div>
          <h3 class="font-heading font-bold text-brown-500 text-lg mb-2">
            {lang === 'es' ? 'Alimentos' : 'Food'}
          </h3>
          <p class="text-gray-600 text-sm">
            {lang === 'es' ? 'Comidas calientes y alimentos no perecederos para familias afectadas' : 'Hot meals and non-perishable food for affected families'}
          </p>
        </div>
        <div class="bg-secondary-50 rounded-2xl p-8 text-center">
          <div class="text-4xl mb-4">🏠</div>
          <h3 class="font-heading font-bold text-brown-500 text-lg mb-2">
            {lang === 'es' ? 'Refugio' : 'Shelter'}
          </h3>
          <p class="text-gray-600 text-sm">
            {lang === 'es' ? 'Albergue temporal y artículos de primera necesidad' : 'Temporary shelter and essential supplies'}
          </p>
        </div>
        <div class="bg-accent-50 rounded-2xl p-8 text-center">
          <div class="text-4xl mb-4">💧</div>
          <h3 class="font-heading font-bold text-brown-500 text-lg mb-2">
            {lang === 'es' ? 'Agua y Salud' : 'Water & Health'}
          </h3>
          <p class="text-gray-600 text-sm">
            {lang === 'es' ? 'Filtros de agua, atención médica y medicamentos' : 'Water filters, medical care and medicine'}
          </p>
        </div>
      </div>

      <div class="overflow-x-auto md:overflow-visible snap-x snap-mandatory md:snap-none -mx-4 px-4 md:mx-0 md:px-0 mb-12">
        <div class="grid grid-cols-[repeat(6,70vw)] md:grid-cols-3 lg:grid-cols-6 gap-4 md:gap-4 snap-proximity">
          <div class="snap-start md:snap-none">
            <img
              src="/images/why-donate/gallery-1.jpg"
              alt={t.whyDonateGallery.option3.gallery1Alt}
              class="aspect-video rounded-xl object-cover w-full hover:scale-105 hover:shadow-lg transition-all duration-300"
              loading="lazy"
              style="background-color: #e5e7eb;"
            />
          </div>
          <div class="snap-start md:snap-none">
            <img
              src="/images/why-donate/gallery-2.jpg"
              alt={t.whyDonateGallery.option3.gallery2Alt}
              class="aspect-video rounded-xl object-cover w-full hover:scale-105 hover:shadow-lg transition-all duration-300"
              loading="lazy"
              style="background-color: #d1d5db;"
            />
          </div>
          <div class="snap-start md:snap-none">
            <img
              src="/images/why-donate/gallery-3.jpg"
              alt={t.whyDonateGallery.option3.gallery3Alt}
              class="aspect-video rounded-xl object-cover w-full hover:scale-105 hover:shadow-lg transition-all duration-300"
              loading="lazy"
              style="background-color: #e5e7eb;"
            />
          </div>
          <div class="snap-start md:snap-none">
            <img
              src="/images/why-donate/gallery-4.jpg"
              alt={t.whyDonateGallery.option3.gallery4Alt}
              class="aspect-video rounded-xl object-cover w-full hover:scale-105 hover:shadow-lg transition-all duration-300"
              loading="lazy"
              style="background-color: #d1d5db;"
            />
          </div>
          <div class="snap-start md:snap-none">
            <img
              src="/images/why-donate/gallery-5.jpg"
              alt={t.whyDonateGallery.option3.gallery5Alt}
              class="aspect-video rounded-xl object-cover w-full hover:scale-105 hover:shadow-lg transition-all duration-300"
              loading="lazy"
              style="background-color: #e5e7eb;"
            />
          </div>
          <div class="snap-start md:snap-none">
            <img
              src="/images/why-donate/gallery-6.jpg"
              alt={t.whyDonateGallery.option3.gallery6Alt}
              class="aspect-video rounded-xl object-cover w-full hover:scale-105 hover:shadow-lg transition-all duration-300"
              loading="lazy"
              style="background-color: #d1d5db;"
            />
          </div>
        </div>
      </div>

      <p class="text-lg md:text-xl text-gray-600 leading-relaxed mb-6 max-w-3xl mx-auto">
        {t.whyDonate.paragraph1}
      </p>
      <p class="text-lg md:text-xl text-gray-600 leading-relaxed mb-10 max-w-3xl mx-auto">
        {t.whyDonate.paragraph2}
      </p>

      <div class="bg-red-50 border-2 border-red-200 rounded-2xl p-6 md:p-8 mb-10 inline-block max-w-2xl mx-auto">
        <p class="text-red-700 font-bold text-lg md:text-xl">
          {t.whyDonate.oneHundred}
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="https://www.paypal.com/paypalme/ungrano"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-10 py-5 bg-red-500 hover:bg-red-600 text-white text-lg font-bold rounded-xl transition-all duration-300 hover:shadow-xl hover:shadow-red-500/30 active:scale-95"
        >
          {t.whyDonate.ctaDonar}
        </a>
      </div>
    </div>
  </div>
</section>
