---
import type { Language } from '../../i18n';
import { getTranslations } from '../../i18n';

interface Props {
  lang?: Language;
}

const { lang = 'es' } = Astro.props;
const t = getTranslations(lang);

const cards = [
  {
    title: lang === 'es' ? 'Alimentos' : 'Food',
    description: lang === 'es' ? 'Comidas calientes y alimentos no perecederos para familias afectadas' : 'Hot meals and non-perishable food for affected families',
    image: '/images/why-donate/alimentos-option4.jpg',
    alt: t.whyDonateGallery.option4.alimentosAlt,
    bgColor: '#fef3c7',
  },
  {
    title: lang === 'es' ? 'Refugio' : 'Shelter',
    description: lang === 'es' ? 'Albergue temporal y artículos de primera necesidad' : 'Temporary shelter and essential supplies',
    image: '/images/why-donate/refugio-option4.jpg',
    alt: t.whyDonateGallery.option4.refugioAlt,
    bgColor: '#dbeafe',
  },
  {
    title: lang === 'es' ? 'Agua y Salud' : 'Water & Health',
    description: lang === 'es' ? 'Filtros de agua, atención médica y medicamentos' : 'Water filters, medical care and medicine',
    image: '/images/why-donate/agua-salud-option4.jpg',
    alt: t.whyDonateGallery.option4.aguaSaludAlt,
    bgColor: '#fce4ec',
  },
];
---

<section class="py-20 md:py-28 bg-white">
  <div class="container-custom px-4">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="font-heading font-bold text-3xl md:text-4xl lg:text-5xl text-brown-500 mb-4">
        {t.whyDonate.title}
      </h2>
      <p class="text-xl md:text-2xl text-primary-500 font-heading font-medium mb-12">
        {t.whyDonate.subtitle}
      </p>

      <div class="flex flex-col gap-6 mb-12 text-left">
        {cards.map((card, index) => (
          <div class={`flex flex-col ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'} bg-white rounded-2xl shadow-md p-6 gap-6 items-center hover:shadow-xl transition-all duration-300`}>
            <div class="w-full md:w-48 shrink-0">
              <img
                src={card.image}
                alt={card.alt}
                class="w-full aspect-video md:aspect-square object-cover rounded-2xl"
                loading="lazy"
                style={`background-color: ${card.bgColor};`}
              />
            </div>
            <div>
              <h3 class="font-heading font-bold text-brown-500 text-xl mb-2">
                {card.title}
              </h3>
              <p class="text-gray-600">
                {card.description}
              </p>
            </div>
          </div>
        ))}
      </div>

      <p class="text-lg md:text-xl text-gray-600 leading-relaxed mb-6 max-w-3xl mx-auto">
        {t.whyDonate.paragraph1}
      </p>
      <p class="text-lg md:text-xl text-gray-600 leading-relaxed mb-10 max-w-3xl mx-auto">
        {t.whyDonate.paragraph2}
      </p>

      <div class="bg-red-50 border-2 border-red-200 rounded-2xl p-6 md:p-8 mb-10 inline-block max-w-2xl mx-auto">
        <p class="text-red-700 font-bold text-lg md:text-xl">
          {t.whyDonate.oneHundred}
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="https://www.paypal.com/paypalme/ungrano"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-10 py-5 bg-red-500 hover:bg-red-600 text-white text-lg font-bold rounded-xl transition-all duration-300 hover:shadow-xl hover:shadow-red-500/30 active:scale-95"
        >
          {t.whyDonate.ctaDonar}
        </a>
      </div>
    </div>
  </div>
</section>
