---
interface Props {
  class?: string;
  image?: string;
  imageAlt?: string;
}

const { class: className = '', image, imageAlt = '' } = Astro.props;
---

<div class={`card ${className}`}>
  {image && (
    <div class="aspect-video overflow-hidden">
      <img 
        src={image} 
        alt={imageAlt} 
        class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
      />
    </div>
  )}
  <div class="card-body">
    <slot />
  </div>
</div>


