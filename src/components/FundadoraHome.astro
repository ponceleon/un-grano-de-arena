---
import Section from './Section.astro';
import type { Language } from '../i18n';
import { getTranslations } from '../i18n';

interface Props {
  lang?: Language;
}

const { lang = 'es' } = Astro.props;
const t = getTranslations(lang);
---

<Section class="bg-primary-100">
  <div class="max-w-5xl mx-auto">
    <!-- Imagen circular centrada -->
    <div class="flex justify-center mb-10">
      <div class="relative">
        <div class="w-48 h-48 rounded-full overflow-hidden shadow-2xl border-4 border-white">
          <img 
            src="/images/jassir-heredia-profile.jpeg" 
            alt="Jassir Heredia - Fundadora"
            class="w-full h-full object-cover"
          />
        </div>
        <!-- Decorative elements -->
        <div class="absolute -bottom-4 -right-4 w-20 h-20 bg-accent-400 rounded-full opacity-20 -z-10"></div>
        <div class="absolute -top-4 -left-4 w-16 h-16 bg-primary-400 rounded-full opacity-20 -z-10"></div>
      </div>
    </div>

    <!-- Contenido centrado -->
    <div class="text-center">
      <div class="mb-8">
        <h2 class="text-4xl font-heading font-bold text-brown-900 mb-4">
          {t.fundadora.title}
        </h2>
        <div class="flex justify-center">
          <div class="w-20 h-1 bg-brown-800 rounded-full"></div>
        </div>
      </div>

      <div class="space-y-6 text-brown-800 max-w-3xl mx-auto">
        <p class="text-lg leading-relaxed">
          {t.fundadora.parrafo1}
        </p>

        <p class="text-lg leading-relaxed">
          {t.fundadora.parrafo2}
        </p>

        <div class="bg-white p-6 rounded-2xl shadow-md border-l-4 border-brown-800">
          <p class="text-lg leading-relaxed font-medium text-brown-800">
            {t.fundadora.destacado1}
          </p>
          <p class="text-xl font-bold text-brown-900 mt-3">
            {t.fundadora.destacado2}
          </p>
        </div>

        <div class="space-y-3 pt-4">
          <p class="text-lg leading-relaxed">
            {t.fundadora.pregunta1}
          </p>
          <p class="text-lg leading-relaxed">
            {t.fundadora.pregunta2}
          </p>
        </div>

        <div class="pt-2">
          <p class="text-2xl font-bold text-brown-900 mb-2">
            {t.fundadora.llamado1}
          </p>
          <p class="text-lg leading-relaxed font-medium text-brown-800">
            {t.fundadora.llamado2}
          </p>
        </div>
      </div>

      <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href="#programas"
          class="inline-flex items-center justify-center px-8 py-4 text-lg font-medium rounded-lg transition-all duration-300 bg-primary-500 text-brown-800 hover:bg-primary-600 hover:shadow-lg active:scale-95"
        >
          {t.fundadora.ctaProgramas}
        </a>
        <a 
          href="https://www.paypal.com/paypalme/ungrano"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-8 py-4 text-lg font-medium rounded-lg transition-all duration-300 border-2 border-primary-600 text-white bg-red-500 hover:bg-red-600 hover:text-white active:scale-95"
        >
          {t.fundadora.ctaDonacion}
        </a>
      </div>
    </div>
  </div>
</Section>
