---
import Section from './Section.astro';
import type { Language } from '../i18n';
import { getTranslations } from '../i18n';

interface Props {
  lang?: Language;
}

const { lang = 'es' } = Astro.props;
const t = getTranslations(lang);
---

<Section class="bg-white">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-brown-700 mb-4">{t.quienesSomos.title}</h2>
      <div class="w-20 h-1 bg-primary-600 mx-auto rounded-full mb-6"></div>
    </div>
    
    <div class="prose prose-lg max-w-none">
      <p class="text-xl text-brown-700 leading-relaxed mb-6">
        <strong>{t.quienesSomos.intro}</strong>
      </p>
      
      <p class="text-lg text-brown-600 leading-relaxed mb-6">
        {t.quienesSomos.parrafo1} <strong>{t.quienesSomos.creemos}</strong>
      </p>

      <p class="text-lg text-brown-600 leading-relaxed mb-8">
        {t.quienesSomos.parrafo2}
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6 mt-12">
      <div class="bg-gradient-to-br from-primary-50 to-white p-8 rounded-2xl shadow-md border-2 border-primary-200">
        <div class="text-4xl mb-4">🌍</div>
        <h3 class="text-xl font-heading font-bold text-brown-700 mb-3">{t.quienesSomos.odsTitle}</h3>
        <p class="text-brown-600">
          {t.quienesSomos.odsDescription}
        </p>
      </div>
      
      <div class="bg-gradient-to-br from-secondary-50 to-white p-8 rounded-2xl shadow-md border-2 border-secondary-200">
        <div class="text-4xl mb-4">⚖️</div>
        <h3 class="text-xl font-heading font-bold text-brown-700 mb-3">{t.quienesSomos.derechosTitle}</h3>
        <p class="text-brown-600">
          {t.quienesSomos.derechosDescription}
        </p>
      </div>
    </div>
  </div>
</Section>
