---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import EmergencyHero from '../components/EmergencyHero.astro';
import WhyDonate from '../components/WhyDonate.astro';
import WhyDonateOption1 from '../components/gallery/WhyDonateOption1.astro';
import WhyDonateOption2 from '../components/gallery/WhyDonateOption2.astro';
import WhyDonateOption3 from '../components/gallery/WhyDonateOption3.astro';
import WhyDonateOption4 from '../components/gallery/WhyDonateOption4.astro';
import Footer from '../components/Footer.astro';
import ModalOverlay from '../components/ModalOverlay';
import { getTranslations } from '../i18n';

const lang = 'es';
const t = getTranslations(lang);
---

<Layout 
  title={t.emergency.title}
  description="Ayuda urgente para las familias afectadas por el terremoto en Venezuela. Un Grano de Arena está recolectando donaciones para llevar asistencia directa."
  lang={lang}
>
  <Header lang={lang} />
  
  <main id="main-content">
    <EmergencyHero lang={lang} />
    <WhyDonate lang={lang} />
    <WhyDonateOption1 lang={lang} />
    <WhyDonateOption2 lang={lang} />
    <WhyDonateOption3 lang={lang} />
    <WhyDonateOption4 lang={lang} />
  </main>

  <Footer lang={lang} />

  <ModalOverlay client:load />
</Layout>
