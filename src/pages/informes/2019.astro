---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Section from '../../components/Section.astro';
import Button from '../../components/Button.astro';
---

<Layout 
  title="Informe Anual 2019"
  description="Año de consolidación y crecimiento. Expandimos nuestros programas y llegamos a más comunidades."
>
  <Header />
  
  <main>
    <!-- Hero -->
    <section class="relative h-[500px] flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img src="/images/informes/informe-2019.jpg" alt="Informe 2019" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-b from-black/70 to-black/60"></div>
      </div>
      
      <div class="relative z-10 container-custom text-center text-white">
        <div class="inline-block bg-secondary-600 px-6 py-2 rounded-full text-xl font-bold mb-6">2019</div>
        <h1 class="font-heading font-bold mb-4">Informe Anual 2019</h1>
        <p class="text-xl max-w-3xl mx-auto">Año de consolidación y expansión</p>
      </div>
    </section>

    <!-- Intro -->
    <Section class="bg-white">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-gray-900 mb-6 text-center">Un Año de Crecimiento</h2>
        <div class="w-20 h-1 bg-secondary-600 mx-auto rounded-full mb-8"></div>
        
        <p class="text-xl text-gray-700 leading-relaxed mb-6">
          El 2019 fue un año de consolidación para Un Grano de Arena. Expandimos nuestros programas, fortalecimos nuestras alianzas y llegamos a más comunidades necesitadas.
        </p>
      </div>
    </Section>

    <!-- Logros -->
    <Section class="bg-gradient-to-br from-secondary-50 to-white">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-gray-900 mb-12 text-center">Logros del 2019</h2>
        
        <div class="grid md:grid-cols-3 gap-8">
          <div class="bg-white p-8 rounded-2xl shadow-lg text-center">
            <div class="text-5xl font-bold text-secondary-600 mb-2">450+</div>
            <p class="text-gray-700 font-semibold">Personas Beneficiadas</p>
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-lg text-center">
            <div class="text-5xl font-bold text-primary-600 mb-2">20+</div>
            <p class="text-gray-700 font-semibold">Actividades Realizadas</p>
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-lg text-center">
            <div class="text-5xl font-bold text-accent-600 mb-2">5</div>
            <p class="text-gray-700 font-semibold">Programas Activos</p>
          </div>
        </div>
      </div>
    </Section>

    <!-- Download -->
    <Section class="bg-gradient-to-br from-secondary-600 to-secondary-800 text-white">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-white mb-6">Descarga el Informe Completo</h2>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/downloads/informe-2019.pdf" download class="btn btn-primary btn-lg">
            📥 Descargar Informe PDF
          </a>
          <Button href="/informes" variant="outline" size="lg" class="border-white text-white hover:bg-white hover:text-secondary-600">
            Ver Todos los Informes
          </Button>
        </div>
      </div>
    </Section>
  </main>

  <Footer />
</Layout>

