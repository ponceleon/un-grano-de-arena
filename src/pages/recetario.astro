---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
---

<Layout 
  title="Recetario - Comida Sana y Vegana"
  description="Descubre nuestro recetario con recetas veganas, tips y consejos para una alimentación saludable y sostenible."
>
  <Header />
  
  <main>
    <!-- Hero Section -->
    <section class="relative h-[500px] flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img 
          src="/images/recetario-hero.jpg" 
          alt="Recetario" 
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-black/70 to-black/60"></div>
      </div>
      
      <div class="relative z-10 container-custom text-center text-white">
        <div class="text-6xl mb-6">🥗</div>
        <h1 class="font-heading font-bold mb-4">Recetario</h1>
        <p class="text-2xl font-semibold text-primary-200 mb-4">Comida Sana y Vegana</p>
        <p class="text-xl max-w-3xl mx-auto">
          Recetas deliciosas que cuidan de ti y del planeta
        </p>
      </div>
    </section>

    <!-- Intro -->
    <Section class="bg-white">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-gray-900 mb-6">Celebrando el Día de la Madre Tierra</h2>
        <div class="w-20 h-1 bg-primary-600 mx-auto rounded-full mb-6"></div>
        <p class="text-lg text-gray-600 leading-relaxed mb-8">
          A propósito de la semana del <strong>Día De la Madre Tierra</strong> y su Campaña <strong>#ACTUAAHORA</strong>, queremos compartir con ustedes nuestro recetario, donde encontrarás recetas, tips, y mucho más de comidas sanas y veganas.
        </p>
        
        <div class="bg-gradient-to-br from-primary-50 to-secondary-50 p-8 rounded-2xl">
          <div class="text-5xl mb-4">🌍</div>
          <h3 class="font-heading font-bold text-2xl text-gray-900 mb-4">#ACTUAAHORA</h3>
          <p class="text-gray-700 mb-6">
            Cada pequeña acción cuenta. La alimentación consciente es una forma poderosa de cuidar nuestro planeta y nuestra salud.
          </p>
        </div>
      </div>
    </Section>

    <!-- Beneficios -->
    <Section class="bg-gradient-to-br from-primary-50 to-white">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-gray-900 mb-12 text-center">¿Por Qué Alimentación Vegana?</h2>
        
        <div class="grid md:grid-cols-3 gap-8">
          <div class="bg-white p-8 rounded-2xl shadow-lg">
            <div class="text-4xl mb-4 text-center">💚</div>
            <h3 class="font-heading font-bold text-xl text-gray-900 mb-3 text-center">Para Tu Salud</h3>
            <ul class="space-y-2 text-gray-600">
              <li>• Rica en nutrientes</li>
              <li>• Baja en grasas saturadas</li>
              <li>• Alto contenido de fibra</li>
              <li>• Reduce riesgos de enfermedades</li>
            </ul>
          </div>
          
          <div class="bg-white p-8 rounded-2xl shadow-lg">
            <div class="text-4xl mb-4 text-center">🌱</div>
            <h3 class="font-heading font-bold text-xl text-gray-900 mb-3 text-center">Para el Planeta</h3>
            <ul class="space-y-2 text-gray-600">
              <li>• Menor huella de carbono</li>
              <li>• Conserva el agua</li>
              <li>• Protege la biodiversidad</li>
              <li>• Reduce la contaminación</li>
            </ul>
          </div>
          
          <div class="bg-white p-8 rounded-2xl shadow-lg">
            <div class="text-4xl mb-4 text-center">🐾</div>
            <h3 class="font-heading font-bold text-xl text-gray-900 mb-3 text-center">Para los Animales</h3>
            <ul class="space-y-2 text-gray-600">
              <li>• Compasión animal</li>
              <li>• Ética y respeto</li>
              <li>• Sin sufrimiento</li>
              <li>• Convivencia armónica</li>
            </ul>
          </div>
        </div>
      </div>
    </Section>

    <!-- Contenido del Recetario -->
    <Section class="bg-white">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-gray-900 mb-12 text-center">Qué Encontrarás</h2>
        
        <div class="grid md:grid-cols-2 gap-6">
          <div class="flex items-start gap-4 p-6 bg-gradient-to-br from-primary-50 to-white rounded-xl">
            <div class="text-3xl">📖</div>
            <div>
              <h3 class="font-heading font-bold text-lg text-gray-900 mb-2">Recetas Deliciosas</h3>
              <p class="text-gray-600">Desde desayunos hasta postres, todas veganas y fáciles de preparar</p>
            </div>
          </div>
          
          <div class="flex items-start gap-4 p-6 bg-gradient-to-br from-secondary-50 to-white rounded-xl">
            <div class="text-3xl">💡</div>
            <div>
              <h3 class="font-heading font-bold text-lg text-gray-900 mb-2">Tips Útiles</h3>
              <p class="text-gray-600">Consejos prácticos para tu cocina y alimentación diaria</p>
            </div>
          </div>
          
          <div class="flex items-start gap-4 p-6 bg-gradient-to-br from-accent-50 to-white rounded-xl">
            <div class="text-3xl">🌿</div>
            <div>
              <h3 class="font-heading font-bold text-lg text-gray-900 mb-2">Información Nutricional</h3>
              <p class="text-gray-600">Conoce los beneficios de cada ingrediente</p>
            </div>
          </div>
          
          <div class="flex items-start gap-4 p-6 bg-gradient-to-br from-primary-50 to-white rounded-xl">
            <div class="text-3xl">🍳</div>
            <div>
              <h3 class="font-heading font-bold text-lg text-gray-900 mb-2">Técnicas de Cocina</h3>
              <p class="text-gray-600">Aprende nuevas formas de preparar alimentos vegetales</p>
            </div>
          </div>
        </div>

        <div class="mt-12 bg-gradient-to-br from-primary-600 to-primary-800 p-10 rounded-2xl text-center text-white">
          <div class="text-5xl mb-4">📚</div>
          <h3 class="font-heading font-bold text-2xl mb-4">Descarga Nuestro Recetario</h3>
          <p class="text-xl text-primary-100 mb-8 max-w-2xl mx-auto">
            Accede a todas nuestras recetas y comienza tu viaje hacia una alimentación más consciente y saludable.
          </p>
          <Button 
            href="/downloads/recetario-un-grano-de-arena.pdf" 
            variant="secondary" 
            size="lg"
          >
            Descargar Recetario PDF
          </Button>
          <p class="mt-4 text-sm text-primary-200">Gratis • Formato PDF • +50 Recetas</p>
        </div>
      </div>
    </Section>

    <!-- CTA Final -->
    <Section class="bg-gradient-to-br from-secondary-50 to-primary-50">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-gray-900 mb-6">Únete al Cambio</h2>
        <p class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto">
          Cada comida es una oportunidad para hacer del mundo un lugar mejor. ¡Comienza hoy!
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button href="/programas" variant="primary" size="lg">
            Conoce Nuestros Programas
          </Button>
          <Button href="/donar" variant="outline" size="lg">
            Apoya Nuestro Trabajo
          </Button>
        </div>
      </div>
    </Section>
  </main>

  <Footer />
</Layout>

