---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Section from '../../components/Section.astro';
import { teamMembers } from '../../data/team';
---

<Layout 
  title="Nuestro Equipo"
  description="Conoce al equipo comprometido de Un Grano de Arena que trabaja día a día para hacer la diferencia."
>
  <Header />
  
  <main>
    <!-- Hero Section -->
    <section class="relative h-96 flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img 
          src="/images/equipo-hero.jpg" 
          alt="Nuestro Equipo" 
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-black/60 to-black/50"></div>
      </div>
      
      <div class="relative z-10 container-custom text-center text-white">
        <h1 class="font-heading font-bold mb-4">Nuestro Equipo</h1>
        <p class="text-xl md:text-2xl max-w-3xl mx-auto">
          Personas apasionadas dedicadas a construir un mundo mejor
        </p>
      </div>
    </section>

    <!-- Team Members -->
    <Section class="bg-white">
      <div class="text-center mb-12">
        <h2 class="text-gray-900 mb-4">Conoce a Nuestro Equipo</h2>
        <div class="w-20 h-1 bg-primary-600 mx-auto rounded-full mb-6"></div>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Un grupo diverso de personas unidas por un mismo propósito: servir a quienes más lo necesitan
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
        {teamMembers.map((member) => (
          <div class="group">
            <div class="bg-white rounded-2xl shadow-lg overflow-hidden transition-all duration-300 hover:shadow-2xl hover:-translate-y-2">
              <!-- Image -->
              <div class="relative aspect-square overflow-hidden">
                <img 
                  src={member.image || '/images/team/placeholder.jpg'} 
                  alt={member.name}
                  class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-110"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
              </div>
              
              <!-- Content -->
              <div class="p-6">
                <h3 class="font-heading font-bold text-xl text-gray-900 mb-2">{member.name}</h3>
                {member.role && (
                  <p class="text-primary-600 font-semibold mb-3">{member.role}</p>
                )}
                {member.bio && (
                  <p class="text-gray-600 text-sm italic">"{member.bio}"</p>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Join Us CTA -->
      <div class="bg-gradient-to-br from-primary-50 to-white rounded-2xl p-12 text-center">
        <h3 class="text-3xl font-heading font-bold text-gray-900 mb-4">
          ¿Quieres ser parte del equipo?
        </h3>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto mb-6">
          Siempre estamos buscando personas comprometidas que quieran sumarse a nuestra misión de cambio social.
        </p>
        <a 
          href="mailto:info@ungrano.org?subject=Quiero ser voluntario"
          class="btn btn-primary btn-lg"
        >
          Contáctanos
        </a>
      </div>
    </Section>
  </main>

  <Footer />
</Layout>


