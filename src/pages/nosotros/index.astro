---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Section from '../../components/Section.astro';
import Button from '../../components/Button.astro';
import VisionMision from '../../components/VisionMision.astro';
---

<Layout 
  title="Nosotros"
  description="Conoce más sobre Un Grano de Arena, nuestra visión, misión y el impacto que generamos en las comunidades."
>
  <Header />
  
  <main>
    <!-- Hero Section -->
    <section class="relative h-96 flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img 
          src="/images/nosotros-hero.jpg" 
          alt="Nosotros" 
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-black/60 to-black/50"></div>
      </div>
      
      <div class="relative z-10 container-custom text-center text-white">
        <h1 class="font-heading font-bold mb-4">Sobre Nosotros</h1>
        <p class="text-xl md:text-2xl max-w-3xl mx-auto">
          Somos una organización sin fines de lucro comprometida con el cambio social
        </p>
      </div>
    </section>

    <!-- Quiénes Somos -->
    <Section class="bg-white">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-gray-900 mb-4">¿Quiénes Somos?</h2>
          <div class="w-20 h-1 bg-primary-600 mx-auto rounded-full mb-6"></div>
        </div>
        
        <div class="prose prose-lg max-w-none">
          <p class="text-xl text-gray-700 leading-relaxed mb-6">
            <strong>Un Grano de Arena</strong> es una organización sin fines de lucro que acompaña en su proceso de florecimiento humano a las personas en situación de vulnerabilidad.
          </p>
          
          <p class="text-lg text-gray-600 leading-relaxed mb-6">
            Creemos firmemente que cada persona tiene un potencial único esperando ser descubierto. A menudo, ese potencial no se descubre por la falta de herramientas o recursos, sino porque no se cree lo suficiente en él. <strong>Nosotros creemos en ti.</strong>
          </p>

          <p class="text-lg text-gray-600 leading-relaxed mb-8">
            Nuestro trabajo se enfoca en crear espacios de encuentro, aprendizaje y crecimiento, donde cada persona pueda desarrollar sus capacidades y contribuir al bien común. A través de programas educativos, atención en salud, promoción de la igualdad y alimentación saludable, trabajamos día a día para construir un mundo más justo e inclusivo.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-6 mt-12">
          <div class="bg-gradient-to-br from-primary-50 to-white p-8 rounded-2xl shadow-md">
            <div class="text-4xl mb-4">🌍</div>
            <h3 class="text-xl font-heading font-bold text-gray-900 mb-3">Guiados por los ODS</h3>
            <p class="text-gray-600">
              Nos guiamos por la Agenda 2030 y los 17 Objetivos de Desarrollo Sostenible de las Naciones Unidas.
            </p>
          </div>
          
          <div class="bg-gradient-to-br from-secondary-50 to-white p-8 rounded-2xl shadow-md">
            <div class="text-4xl mb-4">⚖️</div>
            <h3 class="text-xl font-heading font-bold text-gray-900 mb-3">Derechos Humanos</h3>
            <p class="text-gray-600">
              Nuestro trabajo se fundamenta en la Declaración Universal de los Derechos Humanos.
            </p>
          </div>
        </div>
      </div>
    </Section>

    <!-- Visión y Misión -->
    <VisionMision />

    <!-- Nuestra Fundadora -->
    <Section class="bg-gradient-to-br from-primary-50 to-white">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Imagen de la Fundadora -->
        <div class="order-2 lg:order-1">
          <div class="relative">
            <div class="aspect-[4/5] rounded-3xl overflow-hidden shadow-2xl border-8 border-white">
              <img 
                src="/images/team/jassir-heredia.jpg" 
                alt="Jassir Heredia - Fundadora"
                class="w-full h-full object-cover"
              />
            </div>
            <!-- Decorative element -->
            <div class="absolute -bottom-6 -right-6 w-32 h-32 bg-accent-400 rounded-full opacity-20 -z-10"></div>
            <div class="absolute -top-6 -left-6 w-24 h-24 bg-primary-400 rounded-full opacity-20 -z-10"></div>
          </div>
        </div>

        <!-- Contenido -->
        <div class="order-1 lg:order-2">
          <div class="mb-6">
            <h2 class="text-brown-700 mb-2">Nuestra Fundadora</h2>
            <h3 class="text-2xl font-heading font-bold text-accent-600 mb-4">Jassir Heredia</h3>
            <div class="w-20 h-1 bg-accent-500 rounded-full"></div>
          </div>

          <div class="space-y-6 text-brown-600">
            <p class="text-xl font-semibold text-brown-700 italic">
              "Nadie florece solo. Pongamos juntos un grano de arena."
            </p>

            <p class="text-lg leading-relaxed">
              Creemos que nadie florece solo. Detrás de cada historia de transformación hay una red de manos que sostienen, que empujan hacia adelante.
            </p>

            <p class="text-lg leading-relaxed">
              En Un Grano de Arena, apostamos por lo esencial: crear vínculos que impulsen el crecimiento humano. No desde la caridad, sino desde la colaboración. No para dar, sino para compartir. No para salvar, sino para acompañar.
            </p>

            <div class="bg-white p-6 rounded-2xl shadow-md border-l-4 border-accent-500">
              <p class="text-lg leading-relaxed font-medium text-brown-700">
                Hoy te invitamos a sumar el tuyo. Tu tiempo, tu energía, tu punto de vista cuenta. Tu grano de arena puede ser la raíz de un cambio más grande de lo que imaginas.
              </p>
            </div>

            <p class="text-xl font-bold text-accent-600">
              ¡Únete!
            </p>
          </div>
        </div>
      </div>
    </Section>

    <!-- CTAs -->
    <Section class="bg-gray-50">
      <div class="text-center">
        <h2 class="text-gray-900 mb-6">Únete a Nuestro Trabajo</h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto mb-8">
          Conoce más sobre nuestros aliados estratégicos y cómo puedes colaborar
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button href="/nosotros/aliados" variant="primary" size="lg">
            Nuestros Aliados
          </Button>
          <Button href="/donar" variant="outline" size="lg">
            Donar Ahora
          </Button>
        </div>
      </div>
    </Section>
  </main>

  <Footer />
</Layout>


