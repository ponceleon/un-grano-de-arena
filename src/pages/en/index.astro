---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import EmergencyHero from '../../components/EmergencyHero.astro';
import WhyDonate from '../../components/WhyDonate.astro';
import Footer from '../../components/Footer.astro';
import ModalOverlay from '../../components/ModalOverlay';
import { getTranslations } from '../../i18n';

const lang = 'en';
const t = getTranslations(lang);
---

<Layout 
  title={t.emergency.title}
  description="Urgent relief for families affected by the earthquake in Venezuela. Un Grano de Arena is collecting donations to provide direct assistance."
  lang={lang}
>
  <Header lang={lang} />
  
  <main id="main-content">
    <EmergencyHero lang={lang} />
    <WhyDonate lang={lang} />
  </main>

  <Footer lang={lang} />

  <ModalOverlay client:load />
</Layout>
