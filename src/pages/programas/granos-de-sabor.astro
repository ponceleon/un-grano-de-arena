---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Section from '../../components/Section.astro';
import Button from '../../components/Button.astro';
---

<Layout 
  title="Granos de Sabor - Come Conmigo"
  description="Alimentación para personas en situación de calle y vulnerabilidad."
>
  <Header />
  
  <main>
    <!-- Hero Section -->
    <section class="relative h-[500px] flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img 
          src="/images/programas/sabor.jpg" 
          alt="Granos de Sabor" 
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-black/70 to-black/60"></div>
      </div>
      
      <div class="relative z-10 container-custom text-center text-white">
        <div class="text-5xl mb-4">🍽️</div>
        <h1 class="font-heading font-bold mb-4">Granos de Sabor</h1>
        <p class="text-2xl font-semibold text-secondary-200 mb-4">Come Conmigo</p>
        <p class="text-xl max-w-3xl mx-auto">
          Llevando alimentación a quienes más lo necesitan
        </p>
      </div>
    </section>

    <!-- Descripción -->
    <Section class="bg-white">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-gray-900 mb-6 text-center">Combatiendo el Hambre Juntos</h2>
        <div class="w-20 h-1 bg-secondary-600 mx-auto rounded-full mb-8"></div>
        
        <div class="prose prose-lg max-w-none">
          <p class="text-xl text-gray-700 leading-relaxed mb-6">
            La pobreza es la principal razón por la cual los niños, niñas y adultos tienen hambre, esto significa que van a la cama sin comer.
          </p>
          
          <p class="text-lg text-gray-600 leading-relaxed mb-6">
            Somos conscientes de que el problema del hambre es grave y, aunque la organización no tiene como objetivo principal la nutrición, la situación no puede ignorarse.
          </p>

          <p class="text-lg text-gray-600 leading-relaxed mb-8">
            El proyecto <strong>Come Conmigo</strong> nació como una pequeña contribución para aquellos que en situación de calle tienen poco o ningún acceso a la comida.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-6 mt-12">
          <div class="bg-gradient-to-br from-secondary-50 to-white p-6 rounded-2xl shadow-md text-center">
            <div class="text-4xl mb-3">🥘</div>
            <h3 class="font-heading font-bold text-lg text-gray-900 mb-2">Comidas Calientes</h3>
            <p class="text-gray-600 text-sm">Preparamos y distribuimos comidas nutritivas</p>
          </div>
          
          <div class="bg-gradient-to-br from-primary-50 to-white p-6 rounded-2xl shadow-md text-center">
            <div class="text-4xl mb-3">❤️</div>
            <h3 class="font-heading font-bold text-lg text-gray-900 mb-2">Con Amor</h3>
            <p class="text-gray-600 text-sm">Cada comida se prepara y entrega con dignidad</p>
          </div>
          
          <div class="bg-gradient-to-br from-accent-50 to-white p-6 rounded-2xl shadow-md text-center">
            <div class="text-4xl mb-3">🤝</div>
            <h3 class="font-heading font-bold text-lg text-gray-900 mb-2">Apoyo Integral</h3>
            <p class="text-gray-600 text-sm">Más que comida, ofrecemos compañía y apoyo</p>
          </div>
        </div>

        <div class="bg-primary-50 p-8 rounded-2xl mt-12">
          <h3 class="font-heading font-bold text-2xl text-gray-900 mb-4 text-center">¿Cómo Puedes Ayudar?</h3>
          <div class="grid md:grid-cols-2 gap-6">
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 bg-primary-600 rounded-full flex items-center justify-center flex-shrink-0">
                <span class="text-white font-bold">1</span>
              </div>
              <div>
                <p class="font-semibold text-gray-900">Donaciones</p>
                <p class="text-sm text-gray-600">Tu contribución nos ayuda a comprar alimentos</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 bg-primary-600 rounded-full flex items-center justify-center flex-shrink-0">
                <span class="text-white font-bold">2</span>
              </div>
              <div>
                <p class="font-semibold text-gray-900">Lista de Amazon</p>
                <p class="text-sm text-gray-600">Compra artículos de nuestra lista de necesidades</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Section>

    <!-- CTA -->
    <Section class="bg-gradient-to-br from-secondary-600 to-secondary-800 text-white">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-white mb-6">Apoya Este Programa</h2>
        <p class="text-xl text-secondary-100 mb-8 max-w-2xl mx-auto">
          Tú también puedes poner tu granito de arena a través de Amazon comprando cualquiera de los artículos de la lista, o directamente desde PayPal.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button href="/donar" variant="primary" size="lg">
            Hacer una Donación
          </Button>
          <Button href="/programas" variant="outline" size="lg" class="border-white text-white hover:bg-white hover:text-secondary-600">
            Ver Otros Programas
          </Button>
        </div>
        <p class="mt-8 text-secondary-200">¡Tu apoyo es importante!</p>
      </div>
    </Section>
  </main>

  <Footer />
</Layout>

