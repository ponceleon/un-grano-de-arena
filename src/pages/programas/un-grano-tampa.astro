---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Section from '../../components/Section.astro';
import Button from '../../components/Button.astro';
---

<Layout 
  title="Un Grano Tampa"
  description="Apoyo a familias migrantes en los campos de cosechas de Tampa, Florida."
>
  <Header />
  
  <main>
    <!-- Hero Section -->
    <section class="relative h-[500px] flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img 
          src="/images/programas/tampa.jpg" 
          alt="Un Grano Tampa" 
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-black/70 to-black/60"></div>
      </div>
      
      <div class="relative z-10 container-custom text-center text-white">
        <div class="text-5xl mb-4">🏠</div>
        <h1 class="font-heading font-bold mb-4">Un Grano Tampa</h1>
        <p class="text-2xl font-semibold text-primary-200 mb-4">Apoyo a Familias Migrantes</p>
        <p class="text-xl max-w-3xl mx-auto">
          Siendo puente para las familias en los campos de cosechas
        </p>
      </div>
    </section>

    <!-- Descripción -->
    <Section class="bg-white">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-gray-900 mb-6 text-center">Extendiendo Nuestro Alcance</h2>
        <div class="w-20 h-1 bg-primary-600 mx-auto rounded-full mb-8"></div>
        
        <div class="prose prose-lg max-w-none">
          <p class="text-xl text-gray-700 leading-relaxed mb-6">
            Nuestros granitos se extienden a la ciudad de <strong>Tampa, Florida</strong>, para ser puente a las familias migrantes que viven en los campos de cosechas.
          </p>
          
          <p class="text-lg text-gray-600 leading-relaxed mb-6">
            Un Grano Tampa ofrece apoyo, recursos y acompañamiento a estas familias en su proceso de adaptación y crecimiento en una nueva tierra.
          </p>

          <p class="text-lg text-gray-600 leading-relaxed mb-8">
            Entendemos los desafíos únicos que enfrentan las familias migrantes y trabajamos para brindarles las herramientas necesarias para prosperar en su nuevo hogar.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 mt-12">
          <div class="bg-gradient-to-br from-primary-50 to-white p-8 rounded-2xl shadow-lg">
            <div class="text-4xl mb-4 text-center">🌾</div>
            <h3 class="font-heading font-bold text-xl text-gray-900 mb-4 text-center">Apoyo en los Campos</h3>
            <ul class="space-y-3 text-gray-600">
              <li class="flex items-start gap-3">
                <span class="text-primary-600 text-xl">•</span>
                <span>Recursos para trabajadores agrícolas</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-primary-600 text-xl">•</span>
                <span>Apoyo comunitario</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-primary-600 text-xl">•</span>
                <span>Conexión con servicios locales</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-primary-600 text-xl">•</span>
                <span>Actividades familiares</span>
              </li>
            </ul>
          </div>
          
          <div class="bg-gradient-to-br from-secondary-50 to-white p-8 rounded-2xl shadow-lg">
            <div class="text-4xl mb-4 text-center">🤲</div>
            <h3 class="font-heading font-bold text-xl text-gray-900 mb-4 text-center">Acompañamiento</h3>
            <ul class="space-y-3 text-gray-600">
              <li class="flex items-start gap-3">
                <span class="text-secondary-600 text-xl">•</span>
                <span>Orientación y asesoría</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-secondary-600 text-xl">•</span>
                <span>Apoyo emocional</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-secondary-600 text-xl">•</span>
                <span>Integración cultural</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-secondary-600 text-xl">•</span>
                <span>Red de apoyo comunitario</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="bg-accent-50 p-8 rounded-2xl mt-12 text-center">
          <h3 class="font-heading font-bold text-2xl text-gray-900 mb-4">Ubicación</h3>
          <p class="text-lg text-gray-700 mb-2">📍 Tampa, Florida</p>
          <p class="text-gray-600">Trabajando en los campos de cosechas</p>
        </div>
      </div>
    </Section>

    <!-- CTA -->
    <Section class="bg-gradient-to-br from-primary-600 to-primary-800 text-white">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-white mb-6">Apoya Este Programa</h2>
        <p class="text-xl text-primary-100 mb-8 max-w-2xl mx-auto">
          Tu donación nos ayuda a continuar nuestro trabajo con las familias migrantes en Tampa.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button href="/donar" variant="secondary" size="lg">
            Hacer una Donación
          </Button>
          <Button href="/programas" variant="outline" size="lg" class="border-white text-white hover:bg-white hover:text-primary-600">
            Ver Otros Programas
          </Button>
        </div>
      </div>
    </Section>
  </main>

  <Footer />
</Layout>

