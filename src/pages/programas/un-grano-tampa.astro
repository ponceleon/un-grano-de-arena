---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Section from '../../components/Section.astro';
import Button from '../../components/Button.astro';
---

<Layout 
  title="Granos de Encuentro"
  description="Acompañando a quienes construyen futuro lejos de casa en Estados Unidos."
>
  <Header />
  
  <main>
    <!-- Hero Section -->
    <section class="relative h-[500px] flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img 
          src="/images/programas/tampa.jpg" 
          alt="Granos de Encuentro" 
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-black/70 to-black/60"></div>
      </div>
      
      <div class="relative z-10 container-custom text-center text-white">
        <div class="text-5xl mb-4">🏠</div>
        <h1 class="font-heading font-bold mb-4">Granos de Encuentro</h1>
        <p class="text-2xl font-semibold text-primary-200 mb-4">Acompañando a quienes construyen futuro lejos de casa</p>
        <p class="text-xl max-w-3xl mx-auto">
          Contención, comunidad y apoyo para familias migrantes
        </p>
      </div>
    </section>

    <!-- Descripción -->
    <Section class="bg-white">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-gray-900 mb-6 text-center">Tender Puentes, Tejer Comunidad, Sembrar Esperanza</h2>
        <div class="w-20 h-1 bg-primary-600 mx-auto rounded-full mb-8"></div>
        
        <div class="prose prose-lg max-w-none">
          <p class="text-xl text-gray-700 leading-relaxed mb-6">
            <strong>Granos de Encuentro</strong> nace en Estados Unidos como un espacio de contención, comunidad y apoyo para familias migrantes que han dejado atrás su país buscando un nuevo comienzo.
          </p>
          
          <p class="text-lg text-gray-600 leading-relaxed mb-6">
            Acompañamos a familias provenientes de Venezuela y otros países de América Latina a través de jornadas de entrega de alimentos, orientación, actividades comunitarias y acompañamiento espiritual y emocional.
          </p>

          <p class="text-lg text-gray-600 leading-relaxed mb-8">
            Nuestro propósito es claro: <strong>tender puentes, tejer comunidad y sembrar esperanza</strong> entre quienes enfrentan el desafío de reconstruir su vida en otro país.
          </p>
        </div>

        <div class="bg-gradient-to-br from-primary-50 to-white p-8 rounded-2xl shadow-lg mb-8 text-center">
          <h3 class="font-heading font-bold text-2xl text-gray-900 mb-6">📍 Actualmente Activo en:</h3>
        </div>

        <div class="grid md:grid-cols-2 gap-8 mt-8">
          <div class="bg-gradient-to-br from-primary-50 to-white p-8 rounded-2xl shadow-lg">
            <div class="text-4xl mb-4 text-center">🌴</div>
            <h3 class="font-heading font-bold text-xl text-gray-900 mb-4 text-center">Tampa, Florida</h3>
            <p class="text-gray-600 mb-4 text-center">En colaboración con la Misión Santa María</p>
            <ul class="space-y-3 text-gray-600">
              <li class="flex items-start gap-3">
                <span class="text-primary-600 text-xl">•</span>
                <span>Entrega de alimentos</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-primary-600 text-xl">•</span>
                <span>Orientación y recursos</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-primary-600 text-xl">•</span>
                <span>Conexión con servicios locales</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-primary-600 text-xl">•</span>
                <span>Actividades familiares</span>
              </li>
            </ul>
          </div>
          
          <div class="bg-gradient-to-br from-secondary-50 to-white p-8 rounded-2xl shadow-lg">
            <div class="text-4xl mb-4 text-center">🏛️</div>
            <h3 class="font-heading font-bold text-xl text-gray-900 mb-4 text-center">Área DMV</h3>
            <p class="text-gray-600 mb-4 text-center">Washington D.C., Maryland y Virginia</p>
            <div class="bg-yellow-100 border-l-4 border-yellow-500 p-4 rounded">
              <p class="text-sm font-semibold text-yellow-800 mb-2">🚧 En Desarrollo</p>
              <p class="text-sm text-yellow-700">Próximamente estaremos acompañando a las familias migrantes en esta región con los mismos servicios de apoyo comunitario y espiritual.</p>
            </div>
          </div>
        </div>

        <div class="bg-gradient-to-br from-accent-50 to-white p-8 rounded-2xl mt-12">
          <h3 class="font-heading font-bold text-2xl text-gray-900 mb-6 text-center">¿Qué Ofrecemos?</h3>
          <div class="grid md:grid-cols-3 gap-6">
            <div class="text-center">
              <div class="text-3xl mb-2">🍲</div>
              <p class="font-semibold text-gray-800">Entrega de Alimentos</p>
            </div>
            <div class="text-center">
              <div class="text-3xl mb-2">🤝</div>
              <p class="font-semibold text-gray-800">Orientación y Recursos</p>
            </div>
            <div class="text-center">
              <div class="text-3xl mb-2">❤️</div>
              <p class="font-semibold text-gray-800">Acompañamiento Espiritual</p>
            </div>
            <div class="text-center">
              <div class="text-3xl mb-2">👨‍👩‍👧‍👦</div>
              <p class="font-semibold text-gray-800">Actividades Comunitarias</p>
            </div>
            <div class="text-center">
              <div class="text-3xl mb-2">💪</div>
              <p class="font-semibold text-gray-800">Apoyo Emocional</p>
            </div>
            <div class="text-center">
              <div class="text-3xl mb-2">🌟</div>
              <p class="font-semibold text-gray-800">Red de Apoyo</p>
            </div>
          </div>
        </div>
      </div>
    </Section>

    <!-- CTA -->
    <Section class="bg-gradient-to-br from-primary-600 to-primary-800 text-white">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-white mb-6">Apoya Este Programa</h2>
        <p class="text-xl text-primary-100 mb-8 max-w-2xl mx-auto">
          Tu donación nos ayuda a continuar nuestro trabajo con las familias migrantes en Tampa.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button href="/donar" variant="secondary" size="lg">
            Hacer una Donación
          </Button>
          <Button href="/programas" variant="outline" size="lg" class="border-white text-white hover:bg-white hover:text-primary-600">
            Ver Otros Programas
          </Button>
        </div>
      </div>
    </Section>
  </main>

  <Footer />
</Layout>

