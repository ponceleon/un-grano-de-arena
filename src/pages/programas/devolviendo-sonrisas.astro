---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Section from '../../components/Section.astro';
import Button from '../../components/Button.astro';
---

<Layout 
  title="Devolviendo Sonrisas - Atención Dental"
  description="Brindamos atención dental gratuita a quienes no pueden pagar servicios odontológicos."
>
  <Header />
  
  <main>
    <!-- Hero Section -->
    <section class="relative h-[500px] flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img 
          src="/images/programas/sonrisas.jpg" 
          alt="Devolviendo Sonrisas" 
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-black/70 to-black/60"></div>
      </div>
      
      <div class="relative z-10 container-custom text-center text-white">
        <div class="text-5xl mb-4">😁</div>
        <h1 class="font-heading font-bold mb-4">Devolviendo Sonrisas</h1>
        <p class="text-2xl font-semibold text-secondary-200 mb-4">Pequeños Granos de Sonrisas</p>
        <p class="text-xl max-w-3xl mx-auto">
          Un día para que todos sonrían
        </p>
      </div>
    </section>

    <!-- Descripción -->
    <Section class="bg-white">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-gray-900 mb-6 text-center">Salud Bucal Para Todos</h2>
        <div class="w-20 h-1 bg-secondary-600 mx-auto rounded-full mb-8"></div>
        
        <div class="prose prose-lg max-w-none">
          <p class="text-xl text-gray-700 leading-relaxed mb-6">
            Las personas que no pueden visitar al dentista se pierden la atención dental preventiva que podría ayudar en gran medida a su salud bucal.
          </p>
          
          <p class="text-lg text-gray-600 leading-relaxed mb-6">
            El proyecto <strong>Devolviendo Sonrisas</strong> está enfocado en brindar atención dental a quienes no pueden pagar los servicios dentales. 
          </p>

          <p class="text-lg text-gray-600 leading-relaxed mb-8">
            Nuestro programa <strong>Pequeños Granos de Sonrisas</strong> está estrecha y orgullosamente asociado con el consultorio odontológico <strong>Perfect Smile</strong>. Todo el equipo de Perfect Smile se enorgullece de ofrecer su tiempo y talento como voluntarios para una causa tan valiosa.
          </p>
        </div>

        <div class="bg-gradient-to-br from-secondary-50 to-white p-8 rounded-2xl shadow-lg mb-8">
          <h3 class="font-heading font-bold text-2xl text-gray-900 mb-6 text-center">Servicios Que Ofrecemos</h3>
          <div class="grid md:grid-cols-2 gap-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-secondary-600 rounded-full flex items-center justify-center flex-shrink-0">
                <span class="text-white text-xl">✓</span>
              </div>
              <span class="text-gray-700">Limpieza dental</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-secondary-600 rounded-full flex items-center justify-center flex-shrink-0">
                <span class="text-white text-xl">✓</span>
              </div>
              <span class="text-gray-700">Evaluaciones preventivas</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-secondary-600 rounded-full flex items-center justify-center flex-shrink-0">
                <span class="text-white text-xl">✓</span>
              </div>
              <span class="text-gray-700">Tratamientos básicos</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-secondary-600 rounded-full flex items-center justify-center flex-shrink-0">
                <span class="text-white text-xl">✓</span>
              </div>
              <span class="text-gray-700">Educación en higiene bucal</span>
            </div>
          </div>
        </div>

        <div class="bg-primary-50 p-8 rounded-2xl text-center">
          <h3 class="font-heading font-bold text-xl text-gray-900 mb-3">Nuestro Aliado</h3>
          <p class="text-gray-600 mb-4">En asociación con</p>
          <p class="text-2xl font-bold text-primary-700">Perfect Smile</p>
        </div>
      </div>
    </Section>

    <!-- CTA -->
    <Section class="bg-gradient-to-br from-secondary-600 to-secondary-800 text-white">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-white mb-6">Apoya Este Programa</h2>
        <p class="text-xl text-secondary-100 mb-8 max-w-2xl mx-auto">
          Ayúdanos a seguir llevando salud bucal a quienes más lo necesitan.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button href="/donar" variant="primary" size="lg">
            Hacer una Donación
          </Button>
          <Button href="/programas" variant="outline" size="lg" class="border-white text-white hover:bg-white hover:text-secondary-600">
            Ver Otros Programas
          </Button>
        </div>
      </div>
    </Section>
  </main>

  <Footer />
</Layout>

