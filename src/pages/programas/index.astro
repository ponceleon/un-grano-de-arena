---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Section from '../../components/Section.astro';
import Card from '../../components/Card.astro';
import Button from '../../components/Button.astro';
import { programas } from '../../data/programas';

const iconEmoji: Record<string, string> = {
  book: '📚',
  smile: '😁',
  party: '🎉',
  utensils: '🍽️',
  home: '🏠',
  calendar: '📅',
};
---

<Layout 
  title="Nuestros Programas"
  description="Descubre los programas de Un Grano de Arena que impactan positivamente la vida de las personas en situación de vulnerabilidad."
>
  <Header />
  
  <main>
    <!-- Hero Section -->
    <section class="relative h-[500px] flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img 
          src="/images/programas-hero.jpg" 
          alt="Nuestros Programas" 
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-black/60 to-black/50"></div>
      </div>
      
      <div class="relative z-10 container-custom text-center text-white">
        <h1 class="font-heading font-bold mb-6">Nuestros Programas</h1>
        <p class="text-xl md:text-2xl max-w-3xl mx-auto mb-8">
          Trabajamos en diversos programas que generan impacto real en las comunidades más vulnerables
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <div class="bg-white/20 backdrop-blur-sm px-6 py-3 rounded-full">
            <span class="font-semibold">6 Programas Activos</span>
          </div>
          <div class="bg-white/20 backdrop-blur-sm px-6 py-3 rounded-full">
            <span class="font-semibold">Múltiples Comunidades</span>
          </div>
          <div class="bg-white/20 backdrop-blur-sm px-6 py-3 rounded-full">
            <span class="font-semibold">Impacto Sostenible</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Intro -->
    <Section class="bg-white">
      <div class="max-w-4xl mx-auto text-center mb-12">
        <h2 class="text-gray-900 mb-4">Transformando Vidas</h2>
        <div class="w-20 h-1 bg-primary-600 mx-auto rounded-full mb-6"></div>
        <p class="text-lg text-gray-600 leading-relaxed">
          Cada uno de nuestros programas está diseñado para atender necesidades específicas de las comunidades, promoviendo el desarrollo integral, la dignidad humana y el empoderamiento comunitario.
        </p>
      </div>

      <!-- Programas Grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {programas.map((programa) => (
          <Card image={programa.image} imageAlt={programa.title} class="h-full flex flex-col">
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-12 h-12 bg-primary-100 rounded-full flex items-center justify-center text-2xl">
                  {programa.icon && iconEmoji[programa.icon]}
                </div>
                <h3 class="text-xl font-heading font-bold text-gray-900">{programa.title}</h3>
              </div>
              <p class="text-sm text-primary-600 font-semibold mb-3">{programa.subtitle}</p>
              <p class="text-gray-600 mb-4 line-clamp-4">{programa.description}</p>
            </div>
            <div class="mt-auto">
              <Button href={`/programas/${programa.slug}`} variant="primary" size="sm" class="w-full">
                Conocer Más
              </Button>
            </div>
          </Card>
        ))}
      </div>
    </Section>

    <!-- CTA Section -->
    <Section class="bg-gradient-to-br from-primary-50 to-secondary-50">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-gray-900 mb-6">Apoya Nuestros Programas</h2>
        <p class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto">
          Tu donación nos permite continuar y expandir estos programas para llegar a más personas que lo necesitan.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button href="/donar" variant="primary" size="lg">
            Hacer una Donación
          </Button>
          <Button href="/nosotros" variant="outline" size="lg">
            Conoce Más Sobre Nosotros
          </Button>
        </div>
      </div>
    </Section>
  </main>

  <Footer />
</Layout>

