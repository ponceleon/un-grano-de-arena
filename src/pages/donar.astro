---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import { Heart, CreditCard, Smartphone, Building, ShoppingCart } from 'lucide-react';
---

<Layout 
  title="Donar - Haz la Diferencia"
  description="Tu donación permite a Un Grano de Arena continuar su trabajo con las comunidades más vulnerables. Cada aporte cuenta."
>
  <Header />
  
  <main>
    <!-- Hero Section -->
    <section class="relative h-[500px] flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img 
          src="/images/donar-hero.jpg" 
          alt="Donar" 
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-black/70 to-black/60"></div>
      </div>
      
      <div class="relative z-10 container-custom text-center text-white">
        <div class="text-6xl mb-6">💚</div>
        <h1 class="font-heading font-bold mb-4">Haz una Donación</h1>
        <p class="text-2xl max-w-3xl mx-auto mb-6">
          Con tu aporte podemos cambiar vidas
        </p>
        <p class="text-lg max-w-2xl mx-auto text-primary-200">
          Cada donación, sin importar el monto, nos ayuda a continuar nuestro trabajo y a llevar esperanza a quienes más lo necesitan.
        </p>
      </div>
    </section>

    <!-- Opciones de Donación -->
    <Section class="bg-white">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-gray-900 mb-4">Formas de Donar</h2>
          <div class="w-20 h-1 bg-primary-600 mx-auto rounded-full mb-6"></div>
          <p class="text-lg text-gray-600 max-w-2xl mx-auto">
            Elige la opción que más te convenga. Todas las donaciones son seguras y van directamente a nuestros programas.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 mb-12">
          <!-- PayPal -->
          <div class="bg-gradient-to-br from-primary-50 to-white p-8 rounded-2xl shadow-lg border-2 border-primary-200">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-12 h-12 bg-primary-600 rounded-full flex items-center justify-center">
                <CreditCard class="w-6 h-6 text-white" />
              </div>
              <h3 class="text-2xl font-heading font-bold text-gray-900">PayPal</h3>
            </div>
            <p class="text-gray-600 mb-6">
              Dona fácilmente con PayPal usando tu tarjeta de crédito, débito o cuenta PayPal.
            </p>
            <a 
              href="https://www.paypal.me/ungrano" 
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary w-full mb-3"
            >
              Donar con PayPal
            </a>
            <p class="text-sm text-gray-500 text-center">www.paypal.me/ungrano</p>
          </div>

          <!-- Venmo -->
          <div class="bg-gradient-to-br from-secondary-50 to-white p-8 rounded-2xl shadow-lg border-2 border-secondary-200">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-12 h-12 bg-secondary-600 rounded-full flex items-center justify-center">
                <Smartphone class="w-6 h-6 text-white" />
              </div>
              <h3 class="text-2xl font-heading font-bold text-gray-900">Venmo</h3>
            </div>
            <p class="text-gray-600 mb-6">
              Realiza tu donación de forma rápida y sencilla a través de Venmo.
            </p>
            <a 
              href="https://venmo.com/u/ungrano" 
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-secondary w-full mb-3"
            >
              Donar con Venmo
            </a>
            <p class="text-sm text-gray-500 text-center">@ungrano</p>
          </div>
        </div>

        <!-- Transferencia Bancaria -->
        <div class="bg-gradient-to-br from-accent-50 to-white p-8 rounded-2xl shadow-lg border-2 border-accent-200">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-12 h-12 bg-accent-600 rounded-full flex items-center justify-center">
              <Building class="w-6 h-6 text-white" />
            </div>
            <h3 class="text-2xl font-heading font-bold text-gray-900">Transferencia Bancaria</h3>
          </div>
          
          <div class="grid md:grid-cols-3 gap-6">
            <div>
              <p class="text-sm text-gray-500 mb-1">Nombre del Banco</p>
              <p class="font-semibold text-gray-900">Ocean Bank</p>
            </div>
            <div>
              <p class="text-sm text-gray-500 mb-1">Nombre de la Cuenta</p>
              <p class="font-semibold text-gray-900">Un Grano de Arena USA Corp</p>
            </div>
            <div>
              <p class="text-sm text-gray-500 mb-1">Número de Cuenta</p>
              <p class="font-semibold text-gray-900">2571100805</p>
            </div>
          </div>
        </div>
      </div>
    </Section>

    <!-- Amazon Wish Lists -->
    <Section class="bg-gradient-to-br from-primary-50 to-secondary-50">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <div class="flex items-center justify-center gap-3 mb-4">
            <ShoppingCart class="w-8 h-8 text-primary-600" />
            <h2 class="text-gray-900">Listas de Deseos de Amazon</h2>
          </div>
          <div class="w-20 h-1 bg-primary-600 mx-auto rounded-full mb-6"></div>
          <p class="text-lg text-gray-600 max-w-2xl mx-auto">
            Compra artículos específicos que necesitamos para nuestros programas directamente desde Amazon.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white p-8 rounded-2xl shadow-lg">
            <h3 class="text-xl font-heading font-bold text-gray-900 mb-3">
              🇻🇪 Un Grano de Arena Venezuela
            </h3>
            <p class="text-gray-600 mb-6">
              Artículos necesarios para nuestros programas en Venezuela
            </p>
            <a 
              href="https://www.amazon.com/hz/wishlist/ls/XXXXX" 
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-outline w-full"
            >
              Ver Lista de Deseos
            </a>
          </div>

          <div class="bg-white p-8 rounded-2xl shadow-lg">
            <h3 class="text-xl font-heading font-bold text-gray-900 mb-3">
              😁 Granos de Sonrisas
            </h3>
            <p class="text-gray-600 mb-6">
              Suministros para nuestro programa de salud bucal
            </p>
            <a 
              href="https://www.amazon.com/hz/wishlist/ls/XXXXX" 
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-outline w-full"
            >
              Ver Lista de Deseos
            </a>
          </div>
        </div>

        <div class="mt-8 bg-white p-6 rounded-xl">
          <h4 class="font-heading font-bold text-lg text-gray-900 mb-3">📦 Dirección de Mensajería (para Amazon)</h4>
          <div class="bg-gradient-to-r from-primary-50 to-secondary-50 p-4 rounded-lg">
            <p class="font-semibold text-gray-900 mb-2">Carga Prioritaria</p>
            <p class="text-gray-700">6800 NW 82nd Ave, Doral, FL 33166</p>
            <a href="https://www.prioritycargo.us" target="_blank" rel="noopener noreferrer" class="text-primary-600 hover:text-primary-700 text-sm">
              www.prioritycargo.us
            </a>
          </div>
        </div>
      </div>
    </Section>

    <!-- Donación por Programa -->
    <Section class="bg-white">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-gray-900 mb-4">Dona a un Programa Específico</h2>
          <div class="w-20 h-1 bg-primary-600 mx-auto rounded-full mb-6"></div>
          <p class="text-lg text-gray-600 max-w-2xl mx-auto">
            Si prefieres, puedes hacer una donación dirigida a uno de nuestros programas específicos.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          <div class="bg-gradient-to-br from-primary-50 to-white p-6 rounded-xl shadow-md hover:shadow-xl transition-shadow">
            <div class="text-4xl mb-3">📚</div>
            <h3 class="font-heading font-bold text-lg text-gray-900 mb-2">Granos sobre Ruedas</h3>
            <p class="text-gray-600 text-sm mb-4">Bibliobús móvil y educación</p>
            <Button href="/programas/granos-sobre-ruedas" variant="outline" size="sm" class="w-full">
              Ver Programa
            </Button>
          </div>

          <div class="bg-gradient-to-br from-secondary-50 to-white p-6 rounded-xl shadow-md hover:shadow-xl transition-shadow">
            <div class="text-4xl mb-3">😁</div>
            <h3 class="font-heading font-bold text-lg text-gray-900 mb-2">Devolviendo Sonrisas</h3>
            <p class="text-gray-600 text-sm mb-4">Atención dental gratuita</p>
            <Button href="/programas/devolviendo-sonrisas" variant="outline" size="sm" class="w-full">
              Ver Programa
            </Button>
          </div>

          <div class="bg-gradient-to-br from-accent-50 to-white p-6 rounded-xl shadow-md hover:shadow-xl transition-shadow">
            <div class="text-4xl mb-3">🎉</div>
            <h3 class="font-heading font-bold text-lg text-gray-900 mb-2">Celebrando la Vida</h3>
            <p class="text-gray-600 text-sm mb-4">Actividades recreativas</p>
            <Button href="/programas/celebrando-la-vida" variant="outline" size="sm" class="w-full">
              Ver Programa
            </Button>
          </div>

          <div class="bg-gradient-to-br from-primary-50 to-white p-6 rounded-xl shadow-md hover:shadow-xl transition-shadow">
            <div class="text-4xl mb-3">🍽️</div>
            <h3 class="font-heading font-bold text-lg text-gray-900 mb-2">Granos de Sabor</h3>
            <p class="text-gray-600 text-sm mb-4">Alimentación para personas en situación de calle</p>
            <Button href="/programas/granos-de-sabor" variant="outline" size="sm" class="w-full">
              Ver Programa
            </Button>
          </div>

          <div class="bg-gradient-to-br from-secondary-50 to-white p-6 rounded-xl shadow-md hover:shadow-xl transition-shadow">
            <div class="text-4xl mb-3">🏠</div>
            <h3 class="font-heading font-bold text-lg text-gray-900 mb-2">Un Grano Tampa</h3>
            <p class="text-gray-600 text-sm mb-4">Apoyo a familias migrantes</p>
            <Button href="/programas/un-grano-tampa" variant="outline" size="sm" class="w-full">
              Ver Programa
            </Button>
          </div>

          <div class="bg-gradient-to-br from-accent-50 to-white p-6 rounded-xl shadow-md hover:shadow-xl transition-shadow">
            <div class="text-4xl mb-3">📅</div>
            <h3 class="font-heading font-bold text-lg text-gray-900 mb-2">Actividades</h3>
            <p class="text-gray-600 text-sm mb-4">Eventos y talleres comunitarios</p>
            <Button href="/programas/actividades" variant="outline" size="sm" class="w-full">
              Ver Programa
            </Button>
          </div>
        </div>

        <div class="text-center mt-12">
          <p class="text-lg text-gray-600 mb-4">¿Prefieres hacer una donación general?</p>
          <Button href="https://www.paypal.me/ungrano" variant="primary" size="lg">
            Donar Ahora con PayPal
          </Button>
        </div>
      </div>
    </Section>

    <!-- Por Qué Donar -->
    <Section class="bg-gradient-to-br from-primary-600 to-primary-800 text-white">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-white mb-12 text-center">Por Qué Tu Donación Importa</h2>
        
        <div class="grid md:grid-cols-2 gap-8">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-white rounded-full flex items-center justify-center flex-shrink-0">
              <span class="text-2xl">✓</span>
            </div>
            <div>
              <h3 class="font-heading font-bold text-xl mb-2">Impacto Directo</h3>
              <p class="text-primary-100">Tu donación llega directamente a las comunidades que servimos</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-white rounded-full flex items-center justify-center flex-shrink-0">
              <span class="text-2xl">✓</span>
            </div>
            <div>
              <h3 class="font-heading font-bold text-xl mb-2">Transparencia Total</h3>
              <p class="text-primary-100">Publicamos informes anuales detallados de nuestro trabajo</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-white rounded-full flex items-center justify-center flex-shrink-0">
              <span class="text-2xl">✓</span>
            </div>
            <div>
              <h3 class="font-heading font-bold text-xl mb-2">100% Sin Fines de Lucro</h3>
              <p class="text-primary-100">Somos una organización sin fines de lucro certificada</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-white rounded-full flex items-center justify-center flex-shrink-0">
              <span class="text-2xl">✓</span>
            </div>
            <div>
              <h3 class="font-heading font-bold text-xl mb-2">Cambio Real</h3>
              <p class="text-primary-100">Cada donación genera un impacto tangible en vidas reales</p>
            </div>
          </div>
        </div>

        <div class="text-center mt-12 p-8 bg-white/10 backdrop-blur-sm rounded-2xl">
          <Heart class="w-16 h-16 mx-auto mb-4 text-white" />
          <p class="text-2xl font-heading font-bold mb-2">Juntos podemos construir la paz positiva</p>
          <p class="text-primary-100">Gracias por tu generosidad y compromiso</p>
        </div>
      </div>
    </Section>

    <!-- Contacto -->
    <Section class="bg-white">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-gray-900 mb-6">¿Tienes Preguntas?</h2>
        <p class="text-lg text-gray-600 mb-8 max-w-2xl mx-auto">
          Si tienes alguna duda sobre cómo donar o quieres conocer más sobre cómo se utilizan las donaciones, contáctanos.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="mailto:info@ungrano.org?subject=Consulta sobre Donaciones"
            class="btn btn-primary btn-lg"
          >
            Contáctanos por Email
          </a>
          <Button href="/nosotros" variant="outline" size="lg">
            Conoce Más Sobre Nosotros
          </Button>
        </div>
      </div>
    </Section>
  </main>

  <Footer />
</Layout>

