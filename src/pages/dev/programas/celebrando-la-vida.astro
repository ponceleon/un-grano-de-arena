---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Section from '../../../components/Section.astro';
import Button from '../../../components/Button.astro';
---

<Layout 
  title="Granos de Diversión"
  description="Celebrando la vida con actividades recreativas para niños y adultos mayores en vulnerabilidad."
>
  <Header />
  
  <main>
    <!-- Hero Section -->
    <section class="relative h-[500px] flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img 
          src="/images/programas/celebrando.jpg" 
          alt="Granos de Diversión" 
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-black/70 to-black/60"></div>
      </div>
      
      <div class="relative z-10 container-custom text-center text-white">
        <div class="text-5xl mb-4">🎉</div>
        <h1 class="font-heading font-bold mb-4">Granos de Diversión</h1>
        <p class="text-2xl font-semibold text-accent-200 mb-4">¡Un día especial para ti! Porque lo mereces</p>
        <p class="text-xl max-w-3xl mx-auto">
          Celebrando la vida con alegría, amor y dignidad
        </p>
      </div>
    </section>

    <!-- Descripción -->
    <Section class="bg-white">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-gray-900 mb-6 text-center">La Recreación es una Necesidad Esencial</h2>
        <div class="w-20 h-1 bg-accent-600 mx-auto rounded-full mb-8"></div>
        
        <div class="prose prose-lg max-w-none">
          <p class="text-xl text-gray-700 leading-relaxed mb-6">
            La recreación no es un lujo, es una <strong>necesidad esencial</strong> para una buena salud emocional y mental.
          </p>
          
          <p class="text-lg text-gray-600 leading-relaxed mb-6">
            <strong>Granos de Diversión</strong> es un proyecto creado para celebrar la vida. Está pensado especialmente para niños, niñas y adultos mayores en contextos de vulnerabilidad, ofreciéndoles un día lleno de alegría, actividades lúdicas, música, comida y afecto.
          </p>

          <p class="text-lg text-gray-600 leading-relaxed mb-6">
            Un espacio seguro y festivo, donde cada persona se sienta <strong>querida, vista y valorada</strong>. Un día hecho a medida para quienes rara vez son el centro de la fiesta.
          </p>

          <p class="text-lg text-gray-600 leading-relaxed mb-8">
            Además, es una oportunidad para unir todos nuestros esfuerzos: todos nuestros granitos se pueden encontrar en una sola actividad.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 mt-12">
          <div class="bg-gradient-to-br from-accent-50 to-white p-8 rounded-2xl shadow-lg">
            <div class="text-4xl mb-4 text-center">👶</div>
            <h3 class="font-heading font-bold text-xl text-gray-900 mb-4 text-center">Para Niños</h3>
            <ul class="space-y-3 text-gray-600">
              <li class="flex items-start gap-3">
                <span class="text-accent-600 text-xl">•</span>
                <span>Juegos y actividades recreativas</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-accent-600 text-xl">•</span>
                <span>Música y baile</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-accent-600 text-xl">•</span>
                <span>Comida y meriendas</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-accent-600 text-xl">•</span>
                <span>Regalos y sorpresas</span>
              </li>
            </ul>
          </div>
          
          <div class="bg-gradient-to-br from-primary-50 to-white p-8 rounded-2xl shadow-lg">
            <div class="text-4xl mb-4 text-center">👴</div>
            <h3 class="font-heading font-bold text-xl text-gray-900 mb-4 text-center">Para Adultos Mayores</h3>
            <ul class="space-y-3 text-gray-600">
              <li class="flex items-start gap-3">
                <span class="text-primary-600 text-xl">•</span>
                <span>Actividades sociales y recreativas</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-primary-600 text-xl">•</span>
                <span>Música y entretenimiento</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-primary-600 text-xl">•</span>
                <span>Comida especial</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-primary-600 text-xl">•</span>
                <span>Atención y compañía</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </Section>

    <!-- CTA -->
    <Section class="bg-gradient-to-br from-accent-600 to-accent-800 text-white">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-white mb-6">Apoya Este Programa</h2>
        <p class="text-xl text-accent-100 mb-8 max-w-2xl mx-auto">
          También puedes agregar tu pequeño grano de arena a través de Amazon comprando cualquiera de los artículos de la lista.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button href="/donar" variant="secondary" size="lg">
            Hacer una Donación
          </Button>
          <Button href="/programas" variant="outline" size="lg" class="border-white text-white hover:bg-white hover:text-accent-600">
            Ver Otros Programas
          </Button>
        </div>
      </div>
    </Section>
  </main>

  <Footer />
</Layout>

