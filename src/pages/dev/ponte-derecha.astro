---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Section from '../../components/Section.astro';
import Button from '../../components/Button.astro';
---

<Layout 
  title="Ponte Derecha - Prevención de Violencia de Género"
  description="Charla sobre discriminación, violencia de género y herramientas para la prevención presentada en Women in the City Miami."
>
  <Header />
  
  <main>
    <!-- Hero Section -->
    <section class="relative h-[500px] flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img 
          src="/images/ponte-derecha-hero.jpg" 
          alt="Ponte Derecha" 
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-black/75 to-black/65"></div>
      </div>
      
      <div class="relative z-10 container-custom text-center text-white">
        <div class="text-5xl mb-6">⚖️</div>
        <h1 class="font-heading font-bold mb-4">#PONTEDERECHA</h1>
        <p class="text-2xl font-semibold text-accent-200 mb-4">Prevención de Violencia de Género</p>
        <p class="text-xl max-w-3xl mx-auto">
          Herramientas para reconocer, prevenir y combatir la violencia de género
        </p>
      </div>
    </section>

    <!-- Intro -->
    <Section class="bg-white">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-gray-900 mb-6 text-center">Women in the City Miami</h2>
        <div class="w-20 h-1 bg-accent-600 mx-auto rounded-full mb-8"></div>
        
        <div class="prose prose-lg max-w-none">
          <p class="text-xl text-gray-700 leading-relaxed mb-6">
            Participamos en <strong>Women in the City Miami</strong> a través de nuestra charla <strong>#PONTEDERECHA</strong>, la cual trata de exponer los distintos modos de discriminación, incluyendo las diferentes formas de violencia de género, con una mirada especial al tráfico de mujeres con fines de explotación sexual.
          </p>
          
          <p class="text-lg text-gray-600 leading-relaxed mb-8">
            A su vez, exponemos herramientas que puedan ser utilizadas en la prevención de la violencia de género, en distintos espacios de la vida cotidiana.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-6 mt-12">
          <div class="relative overflow-hidden rounded-2xl shadow-lg">
            <img 
              src="/images/ponte-derecha-1.jpg" 
              alt="Ponte Derecha Event 1"
              class="w-full h-64 object-cover"
            />
          </div>
          <div class="relative overflow-hidden rounded-2xl shadow-lg">
            <img 
              src="/images/ponte-derecha-2.jpg" 
              alt="Ponte Derecha Event 2"
              class="w-full h-64 object-cover"
            />
          </div>
        </div>
      </div>
    </Section>

    <!-- Temas -->
    <Section class="bg-gradient-to-br from-accent-50 to-primary-50">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-gray-900 mb-12 text-center">Temas que Abordamos</h2>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          <div class="bg-white p-8 rounded-2xl shadow-lg">
            <div class="text-4xl mb-4 text-center">🚫</div>
            <h3 class="font-heading font-bold text-xl text-gray-900 mb-3 text-center">Discriminación</h3>
            <p class="text-gray-600 text-center">
              Identificando los distintos modos de discriminación en nuestra sociedad
            </p>
          </div>
          
          <div class="bg-white p-8 rounded-2xl shadow-lg">
            <div class="text-4xl mb-4 text-center">⚠️</div>
            <h3 class="font-heading font-bold text-xl text-gray-900 mb-3 text-center">Violencia de Género</h3>
            <p class="text-gray-600 text-center">
              Reconociendo las diferentes formas de violencia basada en género
            </p>
          </div>
          
          <div class="bg-white p-8 rounded-2xl shadow-lg">
            <div class="text-4xl mb-4 text-center">🔗</div>
            <h3 class="font-heading font-bold text-xl text-gray-900 mb-3 text-center">Tráfico y Explotación</h3>
            <p class="text-gray-600 text-center">
              Visibilizando el tráfico de mujeres con fines de explotación sexual
            </p>
          </div>
          
          <div class="bg-white p-8 rounded-2xl shadow-lg">
            <div class="text-4xl mb-4 text-center">🛡️</div>
            <h3 class="font-heading font-bold text-xl text-gray-900 mb-3 text-center">Prevención</h3>
            <p class="text-gray-600 text-center">
              Herramientas prácticas para prevenir la violencia de género
            </p>
          </div>
          
          <div class="bg-white p-8 rounded-2xl shadow-lg">
            <div class="text-4xl mb-4 text-center">👥</div>
            <h3 class="font-heading font-bold text-xl text-gray-900 mb-3 text-center">Vida Cotidiana</h3>
            <p class="text-gray-600 text-center">
              Aplicando las herramientas en diferentes espacios diarios
            </p>
          </div>
          
          <div class="bg-white p-8 rounded-2xl shadow-lg">
            <div class="text-4xl mb-4 text-center">💪</div>
            <h3 class="font-heading font-bold text-xl text-gray-900 mb-3 text-center">Empoderamiento</h3>
            <p class="text-gray-600 text-center">
              Fortaleciendo a las mujeres para defender sus derechos
            </p>
          </div>
        </div>
      </div>
    </Section>

    <!-- Herramientas -->
    <Section class="bg-white">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-gray-900 mb-12 text-center">Herramientas de Prevención</h2>
        
        <div class="space-y-6">
          <div class="bg-gradient-to-r from-accent-50 to-primary-50 p-6 rounded-xl border-l-4 border-accent-600">
            <h3 class="font-heading font-bold text-lg text-gray-900 mb-2">Reconocer las señales</h3>
            <p class="text-gray-600">Aprender a identificar comportamientos y situaciones de riesgo</p>
          </div>
          
          <div class="bg-gradient-to-r from-primary-50 to-secondary-50 p-6 rounded-xl border-l-4 border-primary-600">
            <h3 class="font-heading font-bold text-lg text-gray-900 mb-2">Comunicación efectiva</h3>
            <p class="text-gray-600">Establecer límites claros y comunicarse de manera asertiva</p>
          </div>
          
          <div class="bg-gradient-to-r from-secondary-50 to-accent-50 p-6 rounded-xl border-l-4 border-secondary-600">
            <h3 class="font-heading font-bold text-lg text-gray-900 mb-2">Redes de apoyo</h3>
            <p class="text-gray-600">Construir y mantener redes de apoyo familiar y comunitario</p>
          </div>
          
          <div class="bg-gradient-to-r from-accent-50 to-primary-50 p-6 rounded-xl border-l-4 border-accent-600">
            <h3 class="font-heading font-bold text-lg text-gray-900 mb-2">Recursos disponibles</h3>
            <p class="text-gray-600">Conocer los recursos legales y servicios de apoyo existentes</p>
          </div>
        </div>

        <div class="mt-12 bg-gradient-to-br from-accent-600 to-accent-800 p-10 rounded-2xl text-center text-white">
          <div class="text-5xl mb-4">📞</div>
          <h3 class="font-heading font-bold text-2xl mb-4">¿Necesitas Ayuda?</h3>
          <p class="text-xl text-accent-100 mb-6 max-w-2xl mx-auto">
            Si tú o alguien que conoces está en una situación de violencia, existen recursos y personas dispuestas a ayudar.
          </p>
          <p class="text-lg font-semibold mb-4">Línea Nacional contra la Violencia Doméstica (USA)</p>
          <a href="tel:1-800-799-7233" class="text-2xl font-bold hover:text-accent-200 transition-colors">
            1-800-799-7233
          </a>
          <p class="mt-4 text-sm text-accent-200">Disponible 24/7 • Confidencial • Multilingüe</p>
        </div>
      </div>
    </Section>

    <!-- CTA -->
    <Section class="bg-gradient-to-br from-accent-600 to-primary-700 text-white">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-white mb-6">Juntos Podemos Hacer la Diferencia</h2>
        <p class="text-xl text-accent-100 mb-8 max-w-2xl mx-auto">
          La prevención de la violencia de género es responsabilidad de todos. Únete a nuestro trabajo por la igualdad y la dignidad.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button href="/donar" variant="secondary" size="lg">
            Apoya Nuestro Trabajo
          </Button>
          <Button href="/nosotros" variant="outline" size="lg" class="border-white text-white hover:bg-white hover:text-accent-600">
            Conoce Más Sobre Nosotros
          </Button>
        </div>
      </div>
    </Section>
  </main>

  <Footer />
</Layout>

